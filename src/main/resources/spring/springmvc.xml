<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/mvc
           http://www.springframework.org/schema/mvc/spring-mvc.xsd">

    <!-- ==================== 控制层 + 拦截器 + 异常处理器扫描 ==================== -->
    <context:component-scan base-package="com.library.controller,com.library.interceptor,com.library.exception"/>

    <!-- ==================== 注解驱动（JSON 转换器自动注册 Jackson） ==================== -->
    <mvc:annotation-driven/>

    <!-- ==================== 三级权限拦截器 ==================== -->
    <mvc:interceptors>
        <!-- 一级：登录拦截（未登录访问受限接口时拦截） -->
        <mvc:interceptor>
            <mvc:mapping path="/*"/>
            <mvc:mapping path="/**"/>
            <mvc:exclude-mapping path="/"/>
            <mvc:exclude-mapping path="/index"/>
            <mvc:exclude-mapping path="/toLogin"/>
            <mvc:exclude-mapping path="/toRegister"/>
            <mvc:exclude-mapping path="/user/login"/>
            <mvc:exclude-mapping path="/user/register"/>
            <!-- 图书浏览对未登录用户开放，借阅/预订动作在业务层校验登录 -->
            <mvc:exclude-mapping path="/book/toBooks"/>
            <mvc:exclude-mapping path="/book/detail/*"/>
            <mvc:exclude-mapping path="/static/**"/>
            <mvc:exclude-mapping path="/uploads/**"/>
            <mvc:exclude-mapping path="/favicon.ico"/>
            <bean class="com.library.interceptor.LoginInterceptor"/>
        </mvc:interceptor>
        <!-- 二级：管理员角色拦截（防止读者越权访问后台） -->
        <mvc:interceptor>
            <mvc:mapping path="/admin/**"/>
            <bean class="com.library.interceptor.RoleInterceptor"/>
        </mvc:interceptor>
    </mvc:interceptors>

    <!-- ==================== 视图解析器（JSP） ==================== -->
    <bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/jsp/"/>
        <property name="suffix" value=".jsp"/>
    </bean>

    <!-- ==================== 文件上传解析器（Spring 6+ 使用 StandardServletMultipartResolver） ==================== -->
    <bean id="multipartResolver" class="org.springframework.web.multipart.support.StandardServletMultipartResolver"/>

    <!-- ==================== 静态资源映射 ==================== -->
    <mvc:resources mapping="/static/**" location="/static/"/>
    <mvc:resources mapping="/uploads/**" location="/uploads/"/>
    <mvc:default-servlet-handler/>
</beans>